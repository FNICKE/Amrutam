# ── Server ─────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/amrutam_db

# ── Redis ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ─────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key
JWT_REFRESH_EXPIRES_IN=7d

# ── Bcrypt ──────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── MFA ─────────────────────────────────────────────
MFA_APP_NAME=Amrutam

# ── Email (SMTP) ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@amrutam.com

# ── Rate Limiting ────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Logs ────────────────────────────────────────────
LOG_LEVEL=info

# ── OpenAI (optional) ───────────────────────────────
# Create a fresh key and keep it only in .env.
OPENAI_API_KEY=
